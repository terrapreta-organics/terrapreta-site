---
layout: layouts/base.njk
---
<section class="wrap top"><div class="eyebrow" style="color:var(--mute)"><a href="/blog/">Field notes</a> &middot; {{ page.date | longDate }}</div><h1 style="font-size:72px">{{ title }}</h1>{% if description %}<p class="intro">{{ description }}</p>{% endif %}</section>
{% if image %}<img class="photo" src="{{ image }}" alt="{{ image_alt }}" style="object-position:{{ image_position or 'center' }}">{% endif %}
<section class="sec wrap grid"><div class="label">{{ category or "Notes" }}</div><div class="article">{{ content | safe }}</div></section>
<section class="cta soil"><div><div class="eyebrow">Request a quote</div><h2>Tell us about your site or your field.</h2></div><div><p>Every quote comes with a rate recommendation.</p><div class="btns"><a class="btn fill" href="/contact/?type=reclamation">Reclamation quote</a><a class="btn" href="/contact/?type=farm">Farm quote</a></div></div></section>

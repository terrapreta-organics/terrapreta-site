<section class="duo"><img class="photo" loading="lazy" src="{{ b.left.image }}" alt="{{ b.left.alt }}" style="object-position:{{ b.left.position or 'center' }}"><img class="photo" loading="lazy" src="{{ b.right.image }}" alt="{{ b.right.alt }}" style="object-position:{{ b.right.position or 'center' }}"></section>{% if b.caption %}<p class="caption wrap">{{ b.caption }}</p>{% endif %}

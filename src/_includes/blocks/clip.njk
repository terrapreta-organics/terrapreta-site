<section class="sec wrap grid clip"><div class="label">{% if b.number %}<span class="n">{{ b.number }}</span>{% endif %}{{ b.label }}</div><div class="clip-row"><div>{% if b.heading %}<h2>{{ b.heading }}</h2>{% endif %}{% if b.body %}<div class="body">{{ b.body | md | safe }}</div>{% endif %}</div><video class="clip-video" src="{{ b.video }}" poster="{{ b.poster }}" muted loop playsinline autoplay preload="metadata" aria-label="{{ b.alt }}"></video></div></section>

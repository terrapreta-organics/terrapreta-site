<section class="sec wrap grid"><div class="label">{% if b.number %}<span class="n">{{ b.number }}</span>{% endif %}{{ b.label }}</div><div>{% if b.heading %}<h2>{{ b.heading }}</h2>{% endif %}{% if b.body %}<div class="body">{{ b.body | md | safe }}</div>{% endif %}{% if b.note %}<p class="note">{{ b.note }}</p>{% endif %}</div></section>

<section class="sec wrap grid"><div class="label">{% if b.number %}<span class="n">{{ b.number }}</span>{% endif %}{{ b.label }}</div><div>{% if b.heading %}<h2>{{ b.heading }}</h2>{% endif %}{% if b.body %}<div class="body">{{ b.body | md | safe }}</div>{% endif %}
<div class="rows">{% for r in b.rows %}{% if not r.hide %}<div class="row"><span class="k">{{ r.key }}</span><span>{{ r.value }}</span><span class="s {{ r.status_style or 'ok' }}">{{ r.status }}</span></div>{% endif %}{% endfor %}</div>{% if b.note %}<p class="note" style="margin-top:20px">{{ b.note }}</p>{% endif %}</div></section>
